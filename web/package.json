{
  "name": "eii-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --strictPort",
    "build": "tsc --noEmit && vite build",
    "lint": "eslint --max-warnings 0 .",
    "format:check": "prettier --check --no-editorconfig .",
    "format": "prettier --write --no-editorconfig .",
    "check": "npm run check:layout && npm run check:versions && npm run check:boundary && npm run check:hosts",
    "check:layout": "node scripts/check-layout.mjs",
    "check:versions": "node scripts/check-exact-versions.mjs",
    "check:boundary": "node scripts/check-import-boundary.mjs",
    "check:hosts": "node scripts/check-no-third-party-hosts.mjs",
    "check:hosts:dist": "node scripts/check-no-third-party-hosts.mjs --dist",
    "check:dev": "node scripts/check-dev-server.mjs",
    "test:checks": "node --test \"scripts/tests/*.node-test.mjs\" \"spikes/glyphs/tests/*.node-test.mjs\" \"spikes/performance/tests/*.node-test.mjs\"",
    "spike:glyphs:build": "vite build --config spikes/glyphs/vite.config.ts",
    "spike:glyphs:install-browser": "node spikes/glyphs/install-browser.mjs",
    "test:spike:glyphs": "node spikes/glyphs/tests/run.mjs",
    "test:spike:performance": "node --test \"spikes/performance/tests/*.node-test.mjs\"",
    "spike:performance:serve": "node spikes/performance/server.mjs",
    "spike:performance:verify-evidence": "node spikes/performance/verify-evidence.mjs",
    "spike:glyphs:record": "node spikes/glyphs/record.mjs",
    "spike:glyphs:verify-evidence": "node spikes/glyphs/verify-evidence.mjs",
    "spike:glyphs:capture": "node spikes/glyphs/tests/run.mjs --capture",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@deck.gl/core": "9.4.1",
    "@deck.gl/geo-layers": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/maplibre": "9.4.1",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "@fontsource/ibm-plex-sans-arabic": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/noto-sans-arabic": "5.3.0",
    "h3-js": "4.5.0",
    "maplibre-gl": "6.17.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
