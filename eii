#!/bin/sh
# EII command launcher.
# Exit status: 0 success, 1 a check or step failed, 2 usage error
# (docs/13_DEPLOYMENT_AND_OPERATIONS.md section 6).
set -eu

usage() {
  printf '%s\n' \
    'eii: usage error: unknown command or flag.' \
    'preflight' \
    'db-up' \
    'db-down' \
    'up' \
    'up --embedded' \
    'down' \
    'down --previous-boot' \
    'test [--seed N] [--suite NAME]' \
    'build-public [--seed N]' \
    'build-public --tenders-only [--resume]' \
    'build-public --gis-imagery-snapshot' \
    'build-public --cdse-backup' \
    'build-public --busyness-bootstrap' \
    'build-public --busyness-confirm SHA256 ROLE DATE' \
    'build-world' \
    'build-release' \
    'load-release' \
    'freeze' \
    'question-lab run --n N --seed S' \
    'remote-check' \
    "CDSE backup boundary: possession of both CDSE values, held only by the lead's wrapper." >&2
  exit 2
}

if [ "$#" -lt 1 ]; then
  usage
fi

word=$1
case "$word" in
  preflight|db-up|db-down|up|down|build-public|build-world|build-release|load-release|freeze|test|question-lab|remote-check)
    ;;
  *)
    usage
    ;;
esac

shift

case "$0" in
  */*) here=${0%/*} ;;
  *) here=. ;;
esac
cd "$here"

if ! command -v uv >/dev/null 2>&1; then
  echo "FAIL tools: uv: not found on PATH; install uv, then run ./eii ${word} again" >&2
  exit 1
fi

if [ "$word" = "test" ]; then
  exec uv run --locked --offline --all-packages --group engine --quiet python -I scripts/run_tests.py "$@"
fi

case "$word" in
  build-public|build-world|build-release)
    exec uv run --locked --offline --package eii-custodian --group engine --quiet python -I scripts/commands/main.py "$word" "$@"
    ;;
  *)
    exec uv run --locked --offline --package eii-product --quiet python -I scripts/commands/main.py "$word" "$@"
    ;;
esac
