#!/bin/sh
# EII command launcher.
# Exit status: 0 success, 1 a check or step failed, 2 usage error
# (docs/13_DEPLOYMENT_AND_OPERATIONS.md section 6).
set -eu

usage() {
  printf '%s\n' \
    'eii: usage error: unknown command or flag.' \
    'preflight' \
    'db-up' \
    'db-down' \
    'up' \
    'up --embedded' \
    'down' \
    'test [--seed N]' \
    'build-public' \
    'build-world' \
    'build-release' \
    'load-release' \
    'freeze' >&2
  exit 2
}

if [ "$#" -lt 1 ]; then
  usage
fi

word=$1
case "$word" in
  preflight|db-up|db-down|up|down|build-public|build-world|build-release|load-release|freeze|test)
    ;;
  *)
    usage
    ;;
esac

shift

case "$0" in
  */*) here=${0%/*} ;;
  *) here=. ;;
esac
cd "$here"

if ! command -v uv >/dev/null 2>&1; then
  echo "FAIL tools: uv: not found on PATH; install uv, then run ./eii ${word} again" >&2
  exit 1
fi

if [ "$word" = "test" ]; then
  exec uv run --locked python -I scripts/run_tests.py "$@"
fi

exec uv run --locked python -I scripts/commands/main.py "$word" "$@"
