from collections.abc import Iterable
from typing import Protocol

class _GeoInterface(Protocol):
    @property
    def __geo_interface__(self) -> dict[str, object]: ...

class LatLngPoly:
    def __init__(self, outer: Iterable[tuple[float, float]]) -> None: ...

def h3shape_to_cells(shape: LatLngPoly, res: int) -> list[str]: ...
def get_resolution(cell: str) -> int: ...
def latlng_to_cell(lat: float, lng: float, res: int) -> str: ...
def grid_disk(h: str, k: int = ...) -> list[str]: ...
def cell_to_latlng(cell: str) -> tuple[float, float]: ...

# h3-py 4.5 API Verbose Reference, read 2026-11-14.
def cell_to_parent(h: str, res: int | None = None) -> str: ...
def cell_to_boundary(h: str) -> tuple[tuple[float, float], ...]: ...
def str_to_int(h: str) -> int: ...

# Installed h3 4.5.0, inspect.signature(int_to_str) == (x), read 2026-11-15.
def int_to_str(x: int) -> str: ...
def geo_to_cells(geo: dict[str, object] | _GeoInterface, res: int) -> list[str]: ...
def great_circle_distance(
    a: tuple[float, float], b: tuple[float, float], unit: str = ...
) -> float: ...
def cell_to_children(h: str, res: int | None = None) -> list[str]: ...
def cells_to_geo(cells: Iterable[str], tight: bool = True) -> dict[str, object]: ...
